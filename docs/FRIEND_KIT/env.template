# Copy this file to ".env" (same folder as sender.exe) and fill in the three values. Never send ".env" to anybody.
# RPC_URL: the HTTPS URL from your Helius dashboard (it contains ?api-key=...)
RPC_URL=
# RPC_WS_URL: the WebSocket URL from the same dashboard (wss://...?api-key=...)
RPC_WS_URL=
# Name of this computer in the experiment. Keep exactly this value.
SLWLAB_PLATFORM=win-b-kyiv-laptop
# Free plan limits (do not raise):
RPC_MAX_RPS=8
RPC_SEND_TX_RPS=1
