/target/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.env
# keys never leave secrets/; only the placeholder is tracked
/secrets/*
!/secrets/.gitkeep
!/secrets/README.md
*.keypair.json
id.json

# shared rate-limit state and ledger lock (local, never committed)
/data/.ratelimit/
/data/**/ledger.jsonl.lock
.env.*
!.env.example

# sender session: open-session pointer and heartbeats (crates/sender/src/session.rs)
/data/sessions/open.json
/data/sessions/*/heartbeat
/data/**/sessions/open.json
/data/**/sessions/*/heartbeat
