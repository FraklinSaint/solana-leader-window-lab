/target/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.env
# keys never leave secrets/; only the placeholder is tracked
/secrets/*
!/secrets/.gitkeep
!/secrets/README.md
*.keypair.json
id.json

# shared rate-limit state and ledger lock (local, never committed)
/data/.ratelimit/
/data/**/ledger.jsonl.lock
.env.*
!.env.example

# session runner: binary copies, open-session pointer, heartbeats (scripts/session.ps1)
/run/
/data/sessions/current.json
/data/sessions/*/heartbeat
