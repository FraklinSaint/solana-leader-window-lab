# Endpoints are read ONLY from the environment (or this file, copied to .env, which is
# git-ignored). Never hardcode them, never pass them as flags: the URL carries the API key.
# Every log line, error and data file redacts `api-key=` values; `make secrets-check` and
# `cargo test --test no_api_keys` fail if one leaks.
#
# Helius (free plan: 1M credits/month, 10 req/s, sendTransaction 1/s, 5 WebSockets):
#   RPC_URL     = the HTTPS RPC URL from the Helius dashboard (contains ?api-key=...)
#   RPC_WS_URL  = the LaserStream WebSocket URL from the dashboard (standard methods only;
#                 only slotSubscribe is used)
RPC_URL=
RPC_WS_URL=
# Client limits (can only be lowered): <= 8 req/s sustained, sendTransaction <= 1/s.
# RPC_MAX_RPS=8
# RPC_SEND_TX_RPS=1
# Monthly credit quota for the 50% warning (data/credits/credits.jsonl keeps the estimate).
# RPC_MONTHLY_CREDITS=1000000
# Optional: validators.app API key for an extra client-evidence source.
VALIDATORS_APP_API_KEY=
# Live sending requires CONFIRM_LIVE=yes on the command line; do not set it here.

# Operator id of the one machine that runs calibration and measurement sessions (required for
# `session --mode calibrate|measure`). Example: SLWLAB_PLATFORM=win-pc1
